<!DOCTYPE html> <html lang="vi"> <head>     <meta charset="UTF-8">     <meta name="viewport" content="width=device-width, initial-scale=1.0">     <title>Bài Trắc Nghiệm Lịch Sử & Địa Lý 9</title>     <script src="https://cdn.tailwindcss.com"></script>     <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">     <style>         body { font-family: 'Inter', sans-serif; }         .option-radio:checked + label {             border-color: #3b82f6;             background-color: #eff6ff;             color: #1d4ed8;             font-weight: 600;         }     </style> </head> <body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">      <!-- Header / Thanh điều hướng -->     <header class="bg-indigo-600 text-white shadow-lg sticky top-0 z-50">         <div class="max-w-5xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-3">             <div>                 <h1 class="text-xl sm:text-2xl font-bold tracking-tight">BÀI KIỂM TRA TRẮC NGHIỆM GIỮA HK1</h1>                 <p class="text-xs sm:text-sm text-indigo-100">Môn: Lịch Sử & Địa Lý 9 | Thang điểm: 6.0 (0.15đ/câu)</p>             </div>             <div id="score-box" class="hidden bg-white text-indigo-900 px-5 py-2.5 rounded-xl shadow-md text-center border border-indigo-100">                 <span class="text-xs font-semibold uppercase tracking-wider block text-slate-500">Kết quả của bạn</span>                 <span id="user-score" class="text-2xl font-extrabold text-indigo-600">0.00</span>                 <span class="text-lg font-bold text-slate-400"> / 6.0</span>             </div>         </div>     </header>      <main class="max-w-5xl mx-auto px-4 py-8 flex-grow w-full">         <!-- Card thông tin học sinh -->         <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 mb-8">             <h2 class="text-base font-bold text-slate-800 uppercase tracking-wide border-b border-slate-100 pb-3 mb-4 flex items-center gap-2">                 <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>                 Thông tin học sinh             </h2>             <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">                 <div>                     <label class="block text-sm font-medium text-slate-700 mb-1.5">Họ và tên học sinh <span class="text-red-500">*</span></label>                     <input type="text" id="student-name" placeholder="Nhập họ và tên..." class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm transition">                 </div>                 <div>                     <label class="block text-sm font-medium text-slate-700 mb-1.5">Lớp <span class="text-red-500">*</span></label>                     <input type="text" id="student-class" placeholder="Ví dụ: 9/4..." class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm transition">                 </div>             </div>         </div>          <!-- Dynamic Form -->         <form id="quiz-form" onsubmit="return false;">             <!-- PHẦN I: LỊCH SỬ -->             <div class="bg-indigo-50/70 border border-indigo-100 p-4 sm:p-5 rounded-2xl mb-6 flex justify-between items-center">                 <div>                     <h2 class="text-lg font-bold text-indigo-950">PHẦN I: LỊCH SỬ (20 CÂU)</h2>                     <p class="text-xs text-indigo-700">Điểm tối đa: 3.0 điểm</p>                 </div>                 <span class="bg-indigo-200 text-indigo-800 text-xs font-bold px-3 py-1 rounded-full">Câu 1 - 20</span>             </div>             <div id="history-section" class="space-y-6 mb-10"></div>              <!-- PHẦN II: ĐỊA LÍ -->             <div class="bg-emerald-50/70 border border-emerald-100 p-4 sm:p-5 rounded-2xl mb-6 flex justify-between items-center">                 <div>                     <h2 class="text-lg font-bold text-emerald-950">PHẦN II: ĐỊA LÍ (20 CÂU)</h2>                     <p class="text-xs text-emerald-700">Điểm tối đa: 3.0 điểm</p>                 </div>                 <span class="bg-emerald-200 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full">Câu 21 - 40</span>             </div>             <div id="geography-section" class="space-y-6"></div>              <!-- Bảng điều khiển nộp bài -->             <div class="sticky bottom-4 mt-10 p-4 bg-white/90 backdrop-blur-md rounded-2xl shadow-xl border border-slate-200 flex flex-col sm:flex-row gap-3 z-40">                 <button type="button" onclick="submitQuiz()" class="flex-1 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-bold py-3.5 px-6 rounded-xl shadow-md transition duration-200 flex items-center justify-center gap-2">                     <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>                     Nộp Bài & Chấm Điểm                 </button>                 <button type="button" onclick="resetQuiz()" class="bg-slate-200 hover:bg-slate-300 active:bg-slate-400 text-slate-700 font-bold py-3.5 px-6 rounded-xl transition duration-200 flex items-center justify-center gap-2">                     <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>                     Làm Lại                 </button>             </div>         </form>     </main>      <footer class="bg-slate-900 text-slate-400 text-center py-6 text-xs mt-auto">         <p>Hệ thống trắc nghiệm Lịch Sử & Địa Lý 9 — Thang điểm 6.0 (40 câu)</p>     </footer>      <script>         const questions = [             // LỊCH SỬ (1-20)             { id: 1, type: 'history', text: "Trọng tâm phát triển kinh tế của Liên Xô từ năm 1922 đến năm 1945 là...", options: ["Phát triển công nghiệp nhẹ", "Phát triển dịch vụ, thương mại", "Phát triển du lịch", "Phát triển công nghiệp nặng"], correct: 3 },             { id: 2, type: 'history', text: "Đảng Bôn – sê – vích quyết định thực hiện \"Chính sách kinh tế mới\" vào thời gian nào?", options: ["Tháng 3 – 1921", "Tháng 12 – 1922", "Tháng 6 – 1925", "Tháng 12 – 1930"], correct: 0 },             { id: 3, type: 'history', text: "Liên bang Cộng hòa xã hội chủ nghĩa Xô viết được thành lập vào thời gian nào?", options: ["Tháng 6 – 1921", "Tháng 12 – 1921", "Tháng 6 – 1922", "Tháng 12 – 1922"], correct: 3 },             { id: 4, type: 'history', text: "Sự kiện nào mở đầu cho cuộc đại suy thoái kinh tế trầm trọng?", options: ["Khủng hoảng chính trị ở Pháp", "Nhà máy Đức bị phá sản hàng loạt", "Thị trường chứng khoán Niu Oóc sụp đổ", "Hàng chục triệu người thất nghiệp ở Pháp"], correct: 2 },             { id: 5, type: 'history', text: "Tổng thống Ru-dơ-ven đã làm gì để đưa nước Mỹ thoát khỏi khủng hoảng?", options: ["Phục hưng công nghiệp", "Giải quyết nạn thất nghiệp", "Tổ chức lại sản xuất", "Thực hiện \"Chính sách mới\""], correct: 3 },             { id: 6, type: 'history', text: "Phong trào cách mạng diễn ra sôi nổi nhất ở quốc gia nào trong giai đoạn 1918 – 1923?", options: ["Đức", "Anh", "Pháp", "Italia"], correct: 0 },             { id: 7, type: 'history', text: "Ngay sau khi Thủ tướng Ta-na-ca đệ trình bản Tấu trình, Nhật Bản đã tiến hành xâm lược quốc gia nào?", options: ["Trung Quốc", "Việt Nam", "Hàn Quốc", "Indonesia"], correct: 0 },             { id: 8, type: 'history', text: "Khởi nghĩa của Ong – Kẹo và Com-ma-đam kéo dài 30 năm (1901 –1937) diễn ra ở quốc gia nào?", options: ["Việt Nam", "Campuchia", "Lào", "Indonesia"], correct: 2 },             { id: 9, type: 'history', text: "Đức tấn công Liên Xô vào thời gian nào?", options: ["Ngày 1 – 9 – 1940", "Ngày 22 – 6 – 1940", "Ngày 22 – 6 – 1941", "Ngày 3 – 9 – 1941"], correct: 2 },             { id: 10, type: 'history', text: "Ngày 6 và ngày 9/8/1945, Mĩ ném bom nguyên tử xuống hai thành phố nào của Nhật Bản?", options: ["Na-gôi-a, Tô-ki-ô", "Tô-ki-ô, Ô-xa-ca", "Hi-rô-si-ma, Na-ga-xa-ki", "Hi-rô-si-ma, Na-gôi-a"], correct: 2 },             { id: 11, type: 'history', text: "Nhật kéo vào Đông Dương vào thời gian nào?", options: ["Tháng 9 / 1940", "Tháng 12/1941", "Tháng 12/1944", "Tháng 8/1945"], correct: 0 },             { id: 12, type: 'history', text: "Ai là người đã lãnh đạo Đảng Quốc đại đấu tranh đòi độc lập ở Ấn Độ (1919 – 1945)?", options: ["Ong-kẹo", "Gan-ni", "Tôn Trung Sơn", "Com-ma-đam"], correct: 1 },             { id: 13, type: 'history', text: "Sự kiện nào mở đầu cho cuộc cách mạng Trung Quốc trong những năm 1919 – 1945?", options: ["Phong trào Ngũ Tứ", "Sự ra đời của Đảng Cộng sản Trung Quốc", "Đảng Cộng sản và Quốc dân đảng hợp tác", "Cách mạng lật đổ tập đoàn Quốc dân đảng"], correct: 0 },             { id: 14, type: 'history', text: "Phong trào dân chủ tư sản tiêu biểu ở Cam-pu-chia giai đoạn 1918 – 1945?", options: ["Khởi nghĩa Ong – Kẹo và Com-ma-đam", "Phong trào do A-cha Hem – chiêu đứng đầu", "Khởi nghĩa Gia-va và Xu-ma-tơ-ra", "Cao trào Xô viết Nghệ - Tĩnh"], correct: 1 },             { id: 15, type: 'history', text: "Đảng Cộng sản Trung Quốc được thành lập vào năm nào?", options: ["1919", "1920", "1921", "1922"], correct: 2 },             { id: 16, type: 'history', text: "Nhật Bản tấn công hạm đội Mĩ ở Trân Châu cảng vào thời gian nào?", options: ["Tháng 12 năm 1939", "Tháng 12 năm 1940", "Tháng 12 năm 1941", "Tháng 12 năm 1943"], correct: 2 },             { id: 17, type: 'history', text: "Chiến thắng nào của quân Đồng minh tạo bước ngoặt làm xoay chuyển tình thế chiến tranh?", options: ["Chiến thắng Xta-lin-grát (2-2-1943)", "Liên quân Anh, Mĩ đổ bộ vào Bắc Pháp", "Hồng quân Liên Xô công phá Béc-lin", "Mĩ ném bom nguyên tử vào Nhật Bản"], correct: 0 },             { id: 18, type: 'history', text: "Đức tấn công Ba Lan vào thời gian nào?", options: ["Ngày 1/9/1939", "Ngày 2/9/1939", "Ngày 3/9/1939", "Ngày 4/9/1939"], correct: 0 },             { id: 19, type: 'history', text: "Vai trò của Liên Xô, Mỹ, Anh trong chiến tranh thế giới thứ hai (1944 – 1945) là gì?", options: ["Lực lượng nòng cốt và quan trọng nhất", "Hậu phương vững chắc", "Lực lượng trụ cột, giữ vai trò quyết định tiêu diệt chủ nghĩa phát xít", "Trực tiếp tiêu diệt chủ nghĩa phát xít Đức"], correct: 2 },             { id: 20, type: 'history', text: "Sự kiện lịch sử nào diễn ra vào ngày 15/8/1945?", options: ["Mĩ thả bom nguyên tử xuống Nhật Bản", "Hồng quân Liên Xô đánh bại quân Quan Đông", "Nhật Bản chấp nhận đầu hàng Đồng minh không điều kiện", "Quân Đồng minh truy kích phát xít Nhật"], correct: 2 },              // ĐỊA LÍ (21-40)             { id: 21, type: 'geography', text: "Số dân của Việt Nam năm 2024 là bao nhiêu?", options: ["96,5 triệu người", "98,5 triệu người", "101,3 triệu người", "103 triệu người"], correct: 2 },             { id: 22, type: 'geography', text: "Tỉ lệ gia tăng dân số của Việt Nam năm 2024 là bao nhiêu?", options: ["0,94%", "1,03%", "1,15%", "1,51%"], correct: 1 },             { id: 23, type: 'geography', text: "Nước ta hiện nay được chia bao nhiêu vùng kinh tế?", options: ["4 vùng", "5 vùng", "6 vùng", "7 vùng"], correct: 2 },             { id: 24, type: 'geography', text: "Điều kiện tự nhiên nào thuận lợi để hình thành vùng chuyên canh cây lương thực, thực phẩm?", options: ["Địa hình đồng bằng và đất feralit", "Địa hình đồng bằng và đất phù sa", "Địa hình đồi núi và đất phù sa", "Địa hình đồi núi và đất feralit"], correct: 1 },             { id: 25, type: 'geography', text: "Nước ta có 3/4 diện tích là đồi núi, đất feralit chủ yếu – đây là điều kiện thuận lợi để...", options: ["Hình thành các vùng chuyên canh cây công nghiệp, cây ăn quả", "Hình thành các vùng chuyên canh cây lương thực", "Cơ cấu mùa vụ và sản phẩm nông nghiệp đa dạng", "Cung cấp nguồn nước cho sản xuất nông nghiệp"], correct: 0 },             { id: 26, type: 'geography', text: "Nhân tố nào sau đây tạo nên sự đa dạng trong cơ cấu mùa vụ và sản phẩm nông nghiệp?", options: ["Sự phân hóa đa dạng của khí hậu", "Khí hậu nhiệt đới ẩm gió mùa", "Do có nhiều loại đất", "Do thị trường"], correct: 0 },             { id: 27, type: 'geography', text: "Nhóm cây trồng nào chiếm tỉ trọng lớn nhất trong cơ cấu giá trị sản xuất ngành trồng trọt nước ta?", options: ["Cây lương thực", "Cây công nghiệp", "Cây rau, đậu", "Cây ăn quả"], correct: 0 },             { id: 28, type: 'geography', text: "Năm 2024, ngành trồng trọt đóng góp bao nhiêu % giá trị sản xuất của ngành nông nghiệp nước ta?", options: ["30.6%", "47.9%", "65.3%", "74.4%"], correct: 3 },             { id: 29, type: 'geography', text: "Hai vùng trọng điểm lúa lớn nhất nước ta hiện nay là...", options: ["Đồng bằng sông Hồng và Đồng bằng sông Cửu Long", "Trung du và miền núi phía Bắc và Tây Nguyên", "Bắc Trung Bộ và Duyên hải Nam Trung Bộ", "Đông Nam Bộ và Đồng bằng sông Cửu Long"], correct: 0 },             { id: 30, type: 'geography', text: "Các cây công nghiệp hàng năm (lạc, đậu tương...) tập trung nhiều ở các vùng nào?", options: ["Tây Nguyên và Đông Nam Bộ", "Trung du và miền núi phía Bắc, Bắc Trung Bộ", "Đồng bằng sông Cửu Long và Đông Nam Bộ", "Duyên hải Nam Trung Bộ và Tây Nguyên"], correct: 1 },             { id: 31, type: 'geography', text: "Cây chè được trồng nhiều nhất ở vùng nào của nước ta hiện nay?", options: ["Bắc Trung Bộ", "Trung du và miền núi phía Bắc", "Đông Nam Bộ", "Duyên hải Nam Trung Bộ và Tây Nguyên"], correct: 1 },             { id: 32, type: 'geography', text: "Vùng nào KHÔNG PHẢI là vùng trồng cây ăn quả lớn nhất cả nước hiện nay?", options: ["Đồng bằng sông Cửu Long", "Trung du và miền núi phía Bắc", "Đông Nam Bộ", "Bắc Trung Bộ"], correct: 3 },             { id: 33, type: 'geography', text: "Năm 2024, tổng diện tích rừng của nước ta là bao nhiêu?", options: ["13,8 triệu ha", "14,1 triệu ha", "14,7 triệu ha", "14,9 triệu ha"], correct: 3 },             { id: 34, type: 'geography', text: "Năm 2024, độ che phủ rừng của nước ta là bao nhiêu?", options: ["27,9%", "33,2%", "39,5%", "42,03%"], correct: 3 },             { id: 35, type: 'geography', text: "Cụm từ viết tắt \"IUU\" trong ngành thủy sản có nghĩa là gì?", options: ["Quy định chống khai thác hải sản bất hợp pháp, không khai báo và không theo quy định", "Vùng có sản lượng nuôi trồng và khai thác thủy sản lớn", "Vùng đánh bắt thủy sản hợp pháp", "Quy định về kích thước các loại thủy sản được đánh bắt"], correct: 0 },             { id: 36, type: 'geography', text: "Vị trí địa lý gần trung tâm ĐNÁ đem lại lợi thế nào cho phát triển công nghiệp nước ta?", options: ["Cung cấp nguồn khoáng sản vô tận", "Thuận lợi giao lưu, hợp tác kinh tế và thu hút vốn đầu tư nước ngoài", "Không chịu ảnh hưởng do thiên tai thời tiết", "Đảm bảo nguồn năng lượng thủy điện dồi dào"], correct: 1 },             { id: 37, type: 'geography', text: "Nhóm nhân tố tự nhiên nào cung cấp nguyên liệu trực tiếp cho công nghiệp chế biến lương thực, thực phẩm?", options: ["Khoáng sản kim loại và phi kim", "Tài nguyên sinh vật và sản phẩm nông - lâm - thủy sản", "Nguồn nước sông ngòi và nước ngầm", "Tài nguyên năng lượng gió và mặt trời"], correct: 1 },             { id: 38, type: 'geography', text: "Khí hậu nhiệt đới ẩm gió mùa KHÔNG PHẢI là điều kiện thuận lợi để phát triển ngành công nghiệp nào?", options: ["Công nghiệp sản xuất, chế biến thực phẩm", "Công nghiệp năng lượng (thủy điện)", "Công nghiệp năng lượng tái tạo", "Công nghiệp cơ khí"], correct: 3 },             { id: 39, type: 'geography', text: "Loại khoáng sản nào vừa là nguyên liệu, vừa là nhiên liệu cho một số ngành công nghiệp?", options: ["Mangan, Crôm", "Than đá, dầu khí", "Crôm, pirit", "Apatit, pirit"], correct: 1 },             { id: 40, type: 'geography', text: "Dân số đông, lao động dồi dào, thị trường tiêu thụ rộng thuộc nhóm nhân tố nào?", options: ["Nhân tố tự nhiên", "Nhân tố kinh tế - xã hội", "Nhân tố môi trường sinh thái", "Nhân tố vị trí địa lý"], correct: 1 }         ];          const prefixes = ["A", "B", "C", "D"];          function renderQuiz() {             const historySec = document.getElementById('history-section');             const geoSec = document.getElementById('geography-section');              questions.forEach(q => {                 const card = document.createElement('div');                 card.className = "bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-slate-200 transition-all duration-200";                 card.id = `card-q${q.id}`;                  let optsHTML = '';                 q.options.forEach((opt, idx) => {                     optsHTML += `                         <div class="relative">                             <input type="radio" id="q${q.id}_opt${idx}" name="q${q.id}" value="${idx}" class="hidden option-radio">                             <label for="q${q.id}_opt${idx}" class="flex items-start p-3 sm:p-3.5 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 transition text-sm">                                 <span class="w-6 h-6 rounded-lg bg-slate-100 border border-slate-300 flex items-center justify-center font-bold text-xs mr-3 shrink-0 text-slate-600 mt-0.5">${prefixes[idx]}</span>                                 <span class="leading-relaxed">${opt}</span>                             </label>                         </div>                     `;                 });                  card.innerHTML = `                     <div class="font-semibold text-slate-900 mb-3 text-sm sm:text-base leading-snug">                         <span class="inline-block bg-indigo-100 text-indigo-700 text-xs font-bold px-2.5 py-1 rounded-md mr-1.5">Câu ${q.id}</span>                         ${q.text}                     </div>                     <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">${optsHTML}</div>                     <div id="result-q${q.id}" class="hidden mt-4 p-3 rounded-xl text-xs sm:text-sm font-medium"></div>                 `;                  if (q.type === 'history') {                     historySec.appendChild(card);                 } else {                     geoSec.appendChild(card);                 }             });         }          function submitQuiz() {             const name = document.getElementById('student-name').value.trim();             const studentClass = document.getElementById('student-class').value.trim();              if (!name || !studentClass) {                 alert('Vui lòng điền đầy đủ Họ tên và Lớp trước khi nộp bài!');                 window.scrollTo({ top: 0, behavior: 'smooth' });                 return;             }              let correctCount = 0;              questions.forEach(q => {                 const selected = document.querySelector(`input[name="q${q.id}"]:checked`);                 const card = document.getElementById(`card-q${q.id}`);                 const resBox = document.getElementById(`result-q${q.id}`);                  resBox.className = "mt-4 p-3 rounded-xl text-xs sm:text-sm font-medium flex items-start gap-2";                  if (selected) {                     const ans = parseInt(selected.value);                     if (ans === q.correct) {                         correctCount++;                         card.className = "bg-white p-5 sm:p-6 rounded-2xl shadow-sm border-2 border-emerald-500";            fill
